#!include:.gitignore

# Historical NDVI files are required by the Cloud Run fallback when Earth
# Engine is unavailable. The repository's general *.csv rule otherwise
# excludes these root-level files from source deployments.
!cleaned_data/
!cleaned_data/NDVI_*.csv

# These large offline source datasets are not loaded by the Flask runtime; the
# NDVI history needed in production is already included from cleaned_data/.
datasets/
satellite_data/
frontend/
tableau_australia_dataset/
